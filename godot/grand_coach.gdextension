[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4

[libraries]
linux.debug.x86_64 = "res://../target/debug/libgui_godot.so"
linux.release.x86_64 = "res://../target/release/libgui_godot.so"
windows.debug.x86_64 = "res://../target/debug/gui_godot.dll"
windows.release.x86_64 = "res://../target/release/gui_godot.dll"
